# This DockerFile is part of the RFSwift project
# Install type: Wi-Fi
# Author(s): Sébastien Dudek (@FlUxIuS) @Penthertz
# website: penthertz.com

ARG BASE_IMAGE=corebuild
FROM ${BASE_IMAGE} AS general_network

LABEL "org.container.project"="rfswift"
LABEL "org.container.author"="Sébastien Dudek (FlUxIuS)"

RUN echo 'APT::Install-Suggests "0";' >> /etc/apt/apt.conf.d/00-docker
RUN echo 'APT::Install-Recommends "0";' >> /etc/apt/apt.conf.d/00-docker
RUN apt-fast update && \
    apt-get install -y software-properties-common && \
    add-apt-repository universe && \
    apt-fast update

ENV PATH="/root/.cargo/bin:${PATH}"

COPY scripts /root/scripts/
COPY rules /root/rules/

WORKDIR /root/scripts/
RUN chmod +x entrypoint.sh

RUN ./entrypoint.sh burpsuite_community_install && \
	./entrypoint.sh seclist_soft_install

# General monitoring, recon and audit software
RUN ./entrypoint.sh nmap_soft_install && \
	./entrypoint.sh wireshark_soft_install && \
	./entrypoint.sh metasploit_soft_install && \
	./entrypoint.sh tshark_soft_install && \
	./entrypoint.sh autorecon_soft_install && \
	./entrypoint.sh trufflehog_script_install && \
	./entrypoint.sh hping3_soft_install && \
	./entrypoint.sh arping_soft_install && \
	./entrypoint.sh argus_soft_install_fromsource && \
	./entrypoint.sh curlie_soft_install_fromsource && \
	./entrypoint.sh vortix_soft_install_fromsource && \
	./entrypoint.sh snitch_soft_install && \
	./entrypoint.sh sslyze_soft_install && \
	./entrypoint.sh netcatopenbsd_soft_install && \
	./entrypoint.sh tailcat_soft_install && \
	./entrypoint.sh telnet_soft_install && \
	./entrypoint.sh nmapautomator_soft_install && \
	./entrypoint.sh trippy_soft_install && \
	./entrypoint.sh titus_soft_install && \
	./entrypoint.sh whosthere_soft_install && \
	./entrypoint.sh ettercap_soft_install && \
	./entrypoint.sh isc_dhcp_server_soft_install && \
	./entrypoint.sh lighttpd_soft_install && \
	./entrypoint.sh crunch_soft_install && \
	./entrypoint.sh netwatch_soft_install_fromsource && \
	./entrypoint.sh sniffnet_soft_install_fromsource

# AD credential tools (DonPAPI, DonPwner) moved to the dedicated `ad` image
RUN ./entrypoint.sh beef_soft_install && \
	./entrypoint.sh above_soft_install

#RUN ./entrypoint.sh tetsuo_h3sec_soft_install
#RUN  ./entrypoint.sh  reconftw_soft_install # takes too much time
	
RUN ./entrypoint.sh subenum_soft_install && \
	./entrypoint.sh webcopilot_soft_install && \
	./entrypoint.sh gowitnes_soft_install && \
	./entrypoint.sh betterleaks_soft_install && \
	./entrypoint.sh ssrfmap_soft_install && \
	./entrypoint.sh graphqlmap_soft_install

RUN ./entrypoint.sh sipvicious_soft_install &&\
	./entrypoint.sh voipire_soft_install &&\
	./entrypoint.sh sippts_soft_install

# AD/Windows tooling (Responder, NetExec, pyGoldenGMSA) lives in the `ad` image

# Some OT tools
RUN ./entrypoint.sh mbtget_soft_install

# Monitoring tools
RUN ./entrypoint.sh kismet_soft_install
RUN ./entrypoint.sh bettercap_soft_install

# Cracking tools & crypto audit
RUN ./entrypoint.sh hashcat_soft_install && \
	./entrypoint.sh johnjumbo_soft_install && \
	./entrypoint.sh cryptocondor_soft_install && \
	./entrypoint.sh brutus_soft_install && \
	./entrypoint.sh nerva_soft_install

# Web pentesting tools
RUN ./entrypoint.sh caido_soft_install && \
	./entrypoint.sh hetty_soft_install && \
	./entrypoint.sh mic_soft_install && \
	./entrypoint.sh sstimap_soft_install && \
	./entrypoint.sh sqlmap_soft_install && \
	./entrypoint.sh  hexhttp_soft_install

# OSINT
RUN ./entrypoint.sh wiretapper_soft_install_fromsource

RUN mkdir -p /sdrtools/
COPY run /sdrtools/run

# Cleaning and quitting
WORKDIR /root/
#RUN rm -rf /root/scripts/
RUN rm -rf /root/rules/
RUN rm -rf /root/thirdparty
RUN apt-fast clean
RUN DEBIAN_FRONTEND=noninteractive rm -rf /var/lib/apt/lists/*
