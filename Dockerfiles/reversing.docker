# This DockerFile is part of the RFSwift project
# Install type: Reversing
# Author(s): Sébastien Dudek (@FlUxIuS) @Penthertz, djnn @Penthertz
# website: penthertz.com
 
ARG BASE_IMAGE=corebuild
FROM ${BASE_IMAGE}

LABEL "org.container.project"="rfswift"
LABEL "org.container.author"="Sébastien Dudek (FlUxIuS)"

RUN echo 'APT::Install-Suggests "0";' >> /etc/apt/apt.conf.d/00-docker
RUN echo 'APT::Install-Recommends "0";' >> /etc/apt/apt.conf.d/00-docker
RUN apt-fast update && \
    apt-get install -y software-properties-common && \
    add-apt-repository universe && \
    apt-fast update

ENV PATH="/root/.cargo/bin:${PATH}"

COPY scripts /root/scripts/
COPY rules /root/rules/

WORKDIR /root/scripts/
RUN chmod +x entrypoint.sh

# Installing Reversing tools
RUN ./entrypoint.sh kataistruct_soft_install && \
 	./entrypoint.sh unicorn_soft_install && \
 	./entrypoint.sh keystone_soft_install && \
 	./entrypoint.sh radare2_soft_install

RUN ./entrypoint.sh ghidra_soft_install

# Installing format extrating tools
RUN ./entrypoint.sh sasquatch_soft_install && \
	./entrypoint.sh unblob_soft_install && \
	./entrypoint.sh binwalk_soft_install && \
	./entrypoint.sh binwalkv3_soft_install && \
	./entrypoint.sh qnx6extractor_soft_install

# adding some SAST / DAST tools
RUN ./entrypoint.sh LLVM_install && \
	./entrypoint.sh AFL_install && \
	./entrypoint.sh honggfuzz_install && \
	./entrypoint.sh semgrep_install && \
	./entrypoint.sh cppcheck_install && \
	./entrypoint.sh clang_static_analyzer_install && \
	./entrypoint.sh joernsast_install && \
	./entrypoint.sh angr_soft_install && \
	./entrypoint.sh angrop_soft_install && \
	./entrypoint.sh trivy_install && \
	./entrypoint.sh sighthound_install

#RUN ./entrypoint.sh appledb_rs_soft_install

RUN ./entrypoint.sh cutter_soft_install &&\
	./entrypoint.sh imhex_soft_install
#RUN ./entrypoint.sh qiling_soft_install # TODO: resolve some debconf
#RUN ./entrypoint.sh emba_soft_install # TODO: takes lot of time

# Exploit development and binary triage
RUN ./entrypoint.sh bytecaster_install && \
	./entrypoint.sh pwndbg_soft_install && \
	./entrypoint.sh gef_soft_install && \
	./entrypoint.sh exploitdev_tools_soft_install && \
	./entrypoint.sh binary_triage_tools_soft_install

# Crypto analysis: bkcrack (ZipCrypto known-plaintext), fplll / fpylll (lattice reduction)
RUN ./entrypoint.sh bkcrack_soft_install && \
	./entrypoint.sh fpylll_soft_install
# Opt-in: SageMath through passagemath (amd64/arm64; about 1.3 GB of wheels, 4 to 5 GB installed).
# Not built by default. Uncomment, or install in a running container:
#   cd /root/scripts && ./entrypoint.sh sage_soft_install
#RUN ./entrypoint.sh sage_soft_install
# Opt-in: OFRAK (Red Balloon Security), amd64 only. Its Community License covers academic and personal
# non-commercial use and does not allow redistributing it, so never enable this in an image you publish.
# Install in your own container (installing it accepts https://ofrak.com/license):
#   cd /root/scripts && OFRAK_ACCEPT_LICENSE=yes ./entrypoint.sh ofrak_soft_install
#RUN OFRAK_ACCEPT_LICENSE=yes ./entrypoint.sh ofrak_soft_install

# Cleaning and quitting
WORKDIR /root/
#RUN rm -rf /root/scripts/
RUN rm -rf /root/rules/
RUN rm -rf /root/thirdparty
RUN apt-fast clean
RUN DEBIAN_FRONTEND=noninteractive rm -rf /var/lib/apt/lists/*
