# This DockerFile is part of the RFSwift project
# Install type: subbuild for SDR
# Author(s): Sébastien Dudek (@FlUxIuS) @Penthertz
# website: penthertz.com

FROM ubuntu:26.04

LABEL "org.container.project"="rfswift"
LABEL "org.container.author"="Sébastien Dudek (FlUxIuS)"

# Ubuntu 26.04 toolchain compatibility for building older third-party sources,
# inherited by every derived image:
#  - GCC 14/15 promoted several K&R-isms to hard errors; relax them back to
#    warnings so old C (and Cython-generated C like lxml) still builds.
#  - CMake 4.x removed compatibility with cmake_minimum_required(VERSION < 3.5);
#    this env restores the old policy floor for projects that still declare it.
ENV CFLAGS="-Wno-incompatible-pointer-types -Wno-int-conversion -Wno-implicit-function-declaration"
ENV CPPFLAGS="-Wno-incompatible-pointer-types -Wno-int-conversion -Wno-implicit-function-declaration"
ENV CMAKE_POLICY_VERSION_MINIMUM="3.5"

RUN echo 'APT::Install-Suggests "0";' >> /etc/apt/apt.conf.d/00-docker
RUN echo 'APT::Install-Recommends "0";' >> /etc/apt/apt.conf.d/00-docker

# Set-up scripts
COPY scripts /root/scripts/
COPY rules /root/rules/
COPY config /root/config/
COPY run/update_rfscripts /usr/sbin
COPY run/rfswift_update /usr/sbin
COPY run/libresdr_swapfpga /usr/sbin
COPY run/avahicontainer_start /usr/sbin
COPY run/rfswift-entrypoint /usr/sbin
COPY run/desktop-start /usr/sbin
COPY run/desktop-stop /usr/sbin
COPY run/desktop-restart /usr/sbin

WORKDIR /root/scripts/
RUN chmod +x entrypoint.sh

# Forcing upgrade for the base image
RUN apt update -y && \
	apt upgrade -y

# Pre-installation tools
RUN ./entrypoint.sh docker_preinstall

# Install a newer version of Go than from PKG manager
RUN ./entrypoint.sh install_go

# Installing Terminal harnesses
RUN ./entrypoint.sh fzf_soft_install && \
	./entrypoint.sh zsh_tools_install && \
	./entrypoint.sh arsenal_soft_install && \
	./entrypoint.sh grimoire_soft_install && \
	./entrypoint.sh audio_tools && \
	./entrypoint.sh rust_tools && \
	./entrypoint.sh atuin_soft_install

RUN ./entrypoint.sh uvpython_install && \
	./entrypoint.sh install_firefox && \
	./entrypoint.sh flameshot_install && \
	./entrypoint.sh littlesnitch_soft_install

# Installing Desktop/VNC packages for remote GUI access
RUN ./entrypoint.sh install_desktop_packages

# Installing VPN tools (WireGuard, OpenVPN, Tailscale, Netbird)
RUN ./entrypoint.sh vpn_tools_install

COPY config/.zshrc /root/.zshrc

# RF Swift shell integration (must be last to append at end of rc files)
RUN ./entrypoint.sh rfswift_shell_setup

# Print the build report (tools/packages that failed to install). The TSV is
# kept under /var/lib/db/ for later extraction; the log lines are greppable.
RUN ./entrypoint.sh print_build_report

# Cleaning and quitting
WORKDIR /root/
RUN rm -rf /root/thirdparty && \
	rm -rf /root/rules/ && \
	rm -rf /root/config/ && \
	apt-fast clean
RUN DEBIAN_FRONTEND=noninteractive rm -rf /var/lib/apt/lists/*
#RUN useradd -ms /bin/bash phzapp
#USER phzapp
