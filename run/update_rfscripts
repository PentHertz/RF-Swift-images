#!/bin/bash

# Colors
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Set the GitHub repository and the directory you want to synchronize.
# Repo and branch are overridable so you can sync the scripts you actually
# committed. The default tracks the current release branch (bump it when the
# active branch changes, e.g. ubuntu_noble -> ubuntu_resolute -> ...).
REPO_URL="${RFSWIFT_SCRIPTS_REPO:-https://github.com/PentHertz/RF-Swift-images}"
BRANCH="${RFSWIFT_SCRIPTS_BRANCH:-ubuntu_resolute}"
SCRIPTS_DIR="scripts"
cd ~
TARGET_DIR="$(pwd)/scripts"  # Use current working directory

# Check if the target directory exists, if not, create it
if [ ! -d "$TARGET_DIR" ]; then
    echo -e "${YELLOW}Creating target directory: $TARGET_DIR${NC}"
    mkdir -p "$TARGET_DIR"
fi

# Move to a temporary directory
TEMP_DIR=$(mktemp -d)
cd "$TEMP_DIR" || { echo -e "${RED}Failed to create temporary directory${NC}"; exit 1; }

# Download the list of files in the scripts directory
echo -e "${BLUE}Fetching ${SCRIPTS_DIR} from $REPO_URL (branch: $BRANCH)${NC}"
curl -fsSL "$REPO_URL/tarball/$BRANCH" | tar -xz --strip=2 --wildcards "*/$SCRIPTS_DIR/*" || { echo -e "${RED}Failed to fetch and extract files from branch '$BRANCH'${NC}"; exit 1; }

# Copy the scripts to the target directory
echo -e "${BLUE}Updating scripts in $TARGET_DIR${NC}"
rsync -av --delete "$TEMP_DIR/" "$TARGET_DIR/" || { echo -e "${RED}Failed to sync files${NC}"; exit 1; }
chmod +x "$TARGET_DIR/entrypoint.sh"

# Cleanup
echo -e "${BLUE}Cleaning up temporary files${NC}"
rm -rf "$TEMP_DIR"

echo -e "${GREEN}Update completed successfully.${NC}"