# ARTEX standalone stack — copy to .env and edit. See README.md in this folder.

# Upstream ref built by `docker compose build`. Default main = always build the latest;
# set a release tag or commit SHA here to pin instead.
ARTEX_REF=main

# Address the web UI is published on. 127.0.0.1 keeps it host-local; set 0.0.0.0 to
# reach it from another machine (the first-run setup token still protects the claim).
ARTEX_BIND_ADDR=127.0.0.1

# PostgreSQL (the only external dependency). Set a real password.
POSTGRES_USER=artex
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=artex

# LLM (fill one or both, or leave empty and configure it in the UI).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ARTEX_LLM_PROVIDER=
ARTEX_LLM_MODEL=
ARTEX_LLM_BASE_URL=
ARTEX_LLM_PROXY=
# Allow the UI model list to reach a local Ollama, e.g. host.docker.internal:11434
ARTEX_LLM_PRIVATE_ENDPOINTS=

# Optional key for secrets encrypted in the database (32 bytes, base64 or hex, e.g.
# `openssl rand -base64 32`). Empty: keys/secret.key is generated at first start; keep
# ./keys persistent or set this, or stored secrets are lost on rebuild.
# ARTEX_SECRET_KEY=

# Reverse proxies (comma-separated CIDRs) whose X-Forwarded-For the login rate limit trusts.
ARTEX_TRUSTED_PROXIES=

# Untrusted-output boundary (frames tool output as data, not instructions). On by default;
# set to 0 to disable.
# ARTEX_UNTRUSTED_BOUNDARY=0

# Noise profile of requests ARTEX sends to targets: off (default) | quiet | balanced | aggressive.
# ARTEX_NOISE_PROFILE=balanced
# ARTEX_TARGET_USER_AGENT=

# Run budgets (optional). Unset or 0 = unlimited. Use a task budget well above 70000 tokens
# for real exploration (one worker costs ~50000).
# ARTEX_TASK_BUDGET_TOKENS=
# ARTEX_TASK_BUDGET_TURNS=
# ARTEX_INTENT_BUDGET_TOKENS=
# ARTEX_INTENT_BUDGET_TURNS=

# Update banner: 1 lets the backend check GitHub releases at most once per 24 h. Off by default.
# ARTEX_UPDATE_CHECK=1
