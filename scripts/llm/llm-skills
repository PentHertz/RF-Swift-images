#!/usr/bin/env python3
# This file is part of the RFSwift project (llm image).
"""llm-skills: manage the agent skill packs installed in the RF Swift llm image.

Packs are git checkouts under /opt/llm-skills/src. `render` writes one directory per
skill under /opt/llm-skills/rendered/<id>: a SKILL.md copy whose Claude-only path
placeholders ({baseDir}, ${CLAUDE_SKILL_DIR}, ${CLAUDE_PLUGIN_ROOT}) are replaced by
absolute paths, so every agent finds the skill's files, plus symlinks to everything else.

Enabling a skill symlinks rendered/<id> into the skill folders the agents read:
  ~/.agents/skills   OpenCode, Codex, Mistral Vibe, Hermes (skills.external_dirs)
  ~/.claude/skills   Claude Code (OpenCode reads it too and keeps one copy per id)
With --project, ./.agents/skills and ./.claude/skills of the current directory instead.
What is enabled is read back from those symlinks; nothing else holds state.
"""

import argparse
import json
import os
import re
import shutil
import subprocess
import sys
from pathlib import Path

ROOT = Path(os.environ.get("LLM_SKILLS_ROOT", "/opt/llm-skills"))
SRC = ROOT / "src"
RENDERED = ROOT / "rendered"
CATALOG = ROOT / "catalog.json"

# pack -> glob of skill directories under SRC, and how far up the Claude plugin root is
PACKS = {
    "trailofbits": {"glob": "trailofbits/plugins/*/skills/*", "plugin_root_up": 2,
                    "url": "https://github.com/trailofbits/skills"},
    "farmage": {"glob": "farmage/skills/*", "url": "https://github.com/farmage/opencode-skills"},
    "floorplan": {"glob": "floorplan/skills/*", "url": "https://github.com/haydenschmitty/floorplan"},
    "cybersecurity": {"glob": "cybersecurity/skills/*",
                      "url": "https://github.com/mukul975/Anthropic-Cybersecurity-Skills"},
    "cloudflare": {"glob": "cloudflare/skills/*", "url": "https://github.com/cloudflare/security-audit-skill"},
    "strix": {"glob": "strix/skills/*", "url": "https://github.com/usestrix/strix"},
    "artex": {"glob": "artex/skills/*", "url": "https://github.com/BaaRai/ARTEX"},
}
INDEX_ID = "cybersecurity-skills"   # generated index skill for the cybersecurity pack
DEFAULTS = ["trailofbits", "farmage", "floorplan", "cloudflare", "strix", "artex", INDEX_ID]


def die(msg):
    print(f"llm-skills: {msg}", file=sys.stderr)
    sys.exit(1)


def target_dirs(project):
    base = Path.cwd() if project else Path.home()
    return [base / ".agents" / "skills", base / ".claude" / "skills"]


# --- frontmatter -----------------------------------------------------------------

def frontmatter(text):
    """Tolerant reader for the few keys we need: name, description, subdomain, tags."""
    m = re.match(r"---\s*\n(.*?)\n---\s*(\n|$)", text, re.S)
    if not m:
        return {}
    out, key = {}, None
    for line in m.group(1).splitlines():
        km = re.match(r"^([A-Za-z_][\w-]*):\s*(.*)$", line)
        if km:
            key, val = km.group(1), km.group(2).strip()
            # "" may open a list or a plain multi-line value; |, >-, ... open a block scalar
            out[key] = [] if val == "" else "" if re.fullmatch(r"[|>][+-]?", val) else val
            continue
        if key is None or not line.startswith((" ", "\t", "-")):
            continue
        item = re.match(r"^\s*-\s+(.*)$", line)
        if item and isinstance(out.get(key), list):
            out[key].append(item.group(1).strip().strip("'\""))
        elif out.get(key) == []:
            out[key] = line.strip()
        elif isinstance(out.get(key), str):
            out[key] += " " + line.strip()
    for k, v in list(out.items()):
        if isinstance(v, str):
            v = v.strip()
            if len(v) >= 2 and v[0] == v[-1] and v[0] in "\"'":
                v = v[1:-1].replace('\\"', '"')
            out[k] = " ".join(v.split())
    return out


# --- render ----------------------------------------------------------------------

def skill_dirs():
    for pack, spec in PACKS.items():
        for d in sorted(SRC.glob(spec["glob"])):
            if (d / "SKILL.md").is_file():
                yield pack, spec, d


def render_one(pack, spec, src_dir, out):
    if out.is_symlink() or out.is_file():
        out.unlink()
    elif out.exists():
        shutil.rmtree(out)
    out.mkdir(parents=True)
    for entry in src_dir.iterdir():
        if entry.name != "SKILL.md":
            (out / entry.name).symlink_to(entry)
    text = (src_dir / "SKILL.md").read_text(errors="replace")
    text = text.replace("{baseDir}", str(out)).replace("${CLAUDE_SKILL_DIR}", str(out))
    up = spec.get("plugin_root_up")
    if up:
        text = text.replace("${CLAUDE_PLUGIN_ROOT}", str(src_dir.parents[up - 1]))
    (out / "SKILL.md").write_text(text)
    return text


def write_index(cyber):
    """One small skill that stands for the whole cybersecurity pack."""
    subs = {}
    for s in cyber:
        subs[s["subdomain"] or "other"] = subs.get(s["subdomain"] or "other", 0) + 1
    lines = "\n".join(f"- `{k}`: {v}" for k, v in sorted(subs.items(), key=lambda kv: -kv[1]))
    out = RENDERED / INDEX_ID
    if out.exists():
        shutil.rmtree(out)
    out.mkdir(parents=True)
    (out / "SKILL.md").write_text(f"""---
name: {INDEX_ID}
description: Index of {len(cyber)} cybersecurity playbooks (Anthropic-Cybersecurity-Skills, MITRE ATT&CK mapped) covering penetration testing, red teaming, web/API/cloud/AD/mobile/ICS security, DFIR, malware analysis, threat intelligence, detection engineering and compliance. Use for any security assessment, exploitation, forensics or hardening task to find and load the matching playbook.
---

# Cybersecurity skills index

The {len(cyber)} skills of the cybersecurity pack are installed but not registered one by
one: their descriptions alone would take about {sum(len(s['description']) for s in cyber) // 4000}K tokens
of context on every turn. Use this index to find the right one.

1. Search the catalog (all words must match the id, subdomain, tags or description):

   ```sh
   llm-skills search sqlmap
   llm-skills search kerberos delegation
   llm-skills search --pack cybersecurity firmware
   ```

2. Read the skill it prints, `{RENDERED}/<id>/SKILL.md`, and follow it as if it had been
   loaded. Its `references/`, `scripts/` and `assets/` sit next to it.

To register a group natively for this user (or for one project with `--project`):
`llm-skills enable cybersecurity:<keyword>` (for example `cybersecurity:web-application-security`,
`cybersecurity:forensics`), or a single skill with `llm-skills enable <id>`. Agents pick new skills
up in a new session.

## Subdomains

{lines}
""")


def cmd_render(args):
    if not SRC.is_dir():
        die(f"{SRC} not found")
    RENDERED.mkdir(parents=True, exist_ok=True)
    catalog, seen = [], {}
    for pack, spec, d in skill_dirs():
        sid = d.name
        if sid in seen or sid == INDEX_ID:
            print(f"llm-skills: skipping {pack}/{sid}: id already used by {seen.get(sid, 'the index')}",
                  file=sys.stderr)
            continue
        seen[sid] = pack
        fm = frontmatter(render_one(pack, spec, d, RENDERED / sid))
        tags = fm.get("tags") if isinstance(fm.get("tags"), list) else []
        catalog.append({"id": sid, "pack": pack, "description": fm.get("description", ""),
                        "subdomain": fm.get("subdomain", "") if isinstance(fm.get("subdomain"), str) else "",
                        "tags": tags, "path": str(RENDERED / sid / "SKILL.md")})
    cyber = [s for s in catalog if s["pack"] == "cybersecurity"]
    if cyber:
        write_index(cyber)
        catalog.append({"id": INDEX_ID, "pack": "cybersecurity-index", "subdomain": "", "tags": [],
                        "description": f"Index of the {len(cyber)} cybersecurity skills",
                        "path": str(RENDERED / INDEX_ID / "SKILL.md")})
    # drop rendered skills whose source is gone
    keep = {s["id"] for s in catalog}
    for old in RENDERED.iterdir():
        if old.name not in keep:
            shutil.rmtree(old) if old.is_dir() and not old.is_symlink() else old.unlink()
    CATALOG.write_text(json.dumps(catalog, indent=1))
    counts = {}
    for s in catalog:
        counts[s["pack"]] = counts.get(s["pack"], 0) + 1
    print("rendered: " + ", ".join(f"{p} {n}" for p, n in counts.items()))


# --- enable / disable / status -----------------------------------------------------

def load_catalog():
    if not CATALOG.is_file():
        die("no catalog yet: run `llm-skills render`")
    return json.loads(CATALOG.read_text())


def resolve(targets, catalog):
    ids = []
    for t in targets:
        if t == "all":
            ids += [s["id"] for s in catalog]
        elif t in PACKS or t == "cybersecurity-index":
            ids += [s["id"] for s in catalog if s["pack"] == t]
        elif ":" in t and t.split(":", 1)[0] in PACKS:
            pack, kw = t.split(":", 1)
            kw = kw.lower()
            hit = [s["id"] for s in catalog if s["pack"] == pack and
                   (kw in s["id"] or kw in s["subdomain"].lower() or any(kw in g.lower() for g in s["tags"]))]
            if not hit:
                die(f"{t}: no skill of {pack} has '{kw}' in its id, subdomain or tags")
            ids += hit
        elif any(s["id"] == t for s in catalog):
            ids.append(t)
        else:
            die(f"unknown pack or skill: {t} (see `llm-skills list`)")
    return list(dict.fromkeys(ids))


def ours(link):
    try:
        return link.is_symlink() and Path(os.readlink(link)).resolve().is_relative_to(RENDERED.resolve())
    except OSError:
        return False


def cmd_enable(args):
    catalog = load_catalog()
    ids = resolve(args.targets, catalog)
    for d in target_dirs(args.project):
        d.mkdir(parents=True, exist_ok=True)
        done = 0
        for sid in ids:
            link = d / sid
            if link.exists() or link.is_symlink():
                if not ours(link):
                    print(f"llm-skills: {link} exists and is not managed by llm-skills, left alone",
                          file=sys.stderr)
                    continue
                link.unlink()
            link.symlink_to(RENDERED / sid)
            done += 1
        print(f"{d}: {done} skill(s) enabled")
    if len(ids) > 200:
        print(f"llm-skills: {len(ids)} skills enabled at once; each description is sent to the model on "
              "every turn (see `llm-skills status`)", file=sys.stderr)


def cmd_disable(args):
    ids = set(resolve(args.targets, load_catalog()))
    for d in target_dirs(args.project):
        n = 0
        for sid in ids:
            if ours(d / sid):
                (d / sid).unlink()
                n += 1
        print(f"{d}: {n} skill(s) disabled")


def cmd_status(args):
    catalog = {s["id"]: s for s in load_catalog()}
    for d in target_dirs(args.project):
        enabled = [p.name for p in d.iterdir() if ours(p)] if d.is_dir() else []
        per, chars = {}, 0
        for sid in enabled:
            s = catalog.get(sid)
            if s:
                per[s["pack"]] = per.get(s["pack"], 0) + 1
                chars += len(s["description"])
        packs = ", ".join(f"{p} {n}" for p, n in sorted(per.items())) or "none"
        print(f"{d}: {len(enabled)} enabled ({packs}); descriptions ~{chars // 4} tokens per turn")


def cmd_list(args):
    catalog = load_catalog()
    if args.pack:
        for s in catalog:
            if s["pack"] == args.pack:
                print(f"{s['id']:<60} {s['subdomain']}")
        return
    on = {p.name for d in target_dirs(False) if d.is_dir() for p in d.iterdir() if ours(p)}
    packs = {}
    for s in catalog:
        tot, en = packs.get(s["pack"], (0, 0))
        packs[s["pack"]] = (tot + 1, en + (s["id"] in on))
    for p, (tot, en) in packs.items():
        print(f"{p:<22} {tot:>4} skills, {en:>4} enabled   {PACKS.get(p, {}).get('url', '')}")


def cmd_search(args):
    words = [w.lower() for w in args.terms]
    n = 0
    for s in load_catalog():
        if args.pack and s["pack"] != args.pack:
            continue
        hay = " ".join([s["id"], s["subdomain"], " ".join(s["tags"]), s["description"]]).lower()
        if all(w in hay for w in words):
            desc = s["description"]
            print(f"{s['id']}  [{s['pack']}]\n  {s['path']}\n  {desc[:240]}{'...' if len(desc) > 240 else ''}")
            n += 1
            if n >= args.limit:
                break
    if n == 0:
        print("no match", file=sys.stderr)
        sys.exit(1)


def cmd_path(args):
    for s in load_catalog():
        if s["id"] == args.id:
            print(s["path"])
            return
    die(f"unknown skill: {args.id}")


def cmd_update(args):
    for d in sorted(SRC.iterdir()):
        if (d / ".git").exists():
            print(f"== {d.name}")
            subprocess.run(["git", "-C", str(d), "pull", "--ff-only"], check=False)
    cmd_render(args)


def main():
    ap = argparse.ArgumentParser(prog="llm-skills", description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)
    sub.add_parser("render", help="(re)build the rendered skill tree and the catalog").set_defaults(fn=cmd_render)
    sub.add_parser("update", help="git pull every pack, then render").set_defaults(fn=cmd_update)
    p = sub.add_parser("list", help="packs and counts, or the skills of one pack")
    p.add_argument("pack", nargs="?")
    p.set_defaults(fn=cmd_list)
    for name, fn, hlp in (("enable", cmd_enable, "register skills with every agent"),
                          ("disable", cmd_disable, "unregister skills")):
        p = sub.add_parser(name, help=hlp,
                           description="TARGET: a pack (trailofbits, farmage, floorplan, cybersecurity, cloudflare, strix, artex), "
                                       "pack:keyword (matches id, subdomain or tags), a skill id, "
                                       f"{INDEX_ID}, or all. Default set: {' '.join(DEFAULTS)}")
        p.add_argument("--project", action="store_true", help="use ./.agents/skills and ./.claude/skills")
        p.add_argument("targets", nargs="+", metavar="TARGET")
        p.set_defaults(fn=fn)
    p = sub.add_parser("status", help="what is enabled and its context cost")
    p.add_argument("--project", action="store_true")
    p.set_defaults(fn=cmd_status)
    p = sub.add_parser("search", help="search all packs, enabled or not")
    p.add_argument("--pack")
    p.add_argument("--limit", type=int, default=20)
    p.add_argument("terms", nargs="+")
    p.set_defaults(fn=cmd_search)
    p = sub.add_parser("path", help="print the SKILL.md path of a skill")
    p.add_argument("id")
    p.set_defaults(fn=cmd_path)
    args = ap.parse_args()
    args.fn(args)


if __name__ == "__main__":
    main()
