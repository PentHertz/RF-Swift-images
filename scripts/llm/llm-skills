# --- frontmatter -----------------------------------------------------------------

NESTED = ("subdomain", "tags", "when_to_use")   # also read from under a top-level `metadata:`


def frontmatter(text):
    """Tolerant reader for the few keys we need: name, description, subdomain, tags, when_to_use.
    subdomain, tags and when_to_use may also sit under `metadata:` (Decepticon, Agent Skills spec);
    a top-level key wins."""
    m = re.match(r"---\s*\n(.*?)\n---\s*(\n|$)", text, re.S)
    if not m:
        return {}
    lines, meta = m.group(1).splitlines(), []
    for i, line in enumerate(lines):
        if re.fullmatch(r"metadata:\s*", line):
            j = i + 1
            while j < len(lines) and (not lines[j].strip() or lines[j][0] in " \t-"):
                j += 1
            meta, lines = lines[i + 1:j], lines[:i] + lines[j:]
            break
    out = _fm_lines(lines)
    if meta:
        ind = min(len(s) - len(s.lstrip()) for s in meta if s.strip())
        for k, v in _fm_lines([s[ind:] for s in meta]).items():
            if k in NESTED and k not in out:
                out[k] = v
    return out


def _fm_lines(lines):
    out, key = {}, None
    for line in lines:
        km = re.match(r"^([A-Za-z_][\w-]*):\s*(.*)$", line)
        if km:
            key, val = km.group(1), km.group(2).strip()
            # "" may open a list or a plain multi-line value; |, >-, ... open a block scalar
            out[key] = [] if val == "" else "" if re.fullmatch(r"[|>][+-]?", val) else val
            continue
        if key is None or not line.startswith((" ", "\t", "-")):
            continue
        item = re.match(r"^\s*-\s+(.*)$", line)
        if item and isinstance(out.get(key), list):
            out[key].append(item.group(1).strip().strip("'\""))
        elif out.get(key) == []:
            out[key] = line.strip()
        elif isinstance(out.get(key), str):
            out[key] += " " + line.strip()
    for k, v in list(out.items()):
        if isinstance(v, str):
            v = v.strip()
            if len(v) >= 2 and v[0] == v[-1] and v[0] in "\"'":
                v = v[1:-1].replace('\\"', '"')
            out[k] = " ".join(v.split())
    return out


def tag_list(v):
    """tags as a YAML list, a flow list ("[a, b]") or a comma-separated string"""
    if isinstance(v, list):
        return [t for t in v if t]
    if isinstance(v, str):
        v = v.strip()
        if v.startswith("[") and v.endswith("]"):
            v = v[1:-1]
        return [t.strip().strip("'\"") for t in v.split(",") if t.strip().strip("'\"")]
    return []


# --- render ----------------------------------------------------------------------

def skill_dirs():
    for pack, spec in PACKS.items():
        exclude = set(spec.get("exclude", ()))
        if "root" not in spec:
            for d in sorted(SRC.glob(spec["glob"])):
                if (d / "SKILL.md").is_file() and d.name not in exclude:
                    yield pack, spec, d
            continue
        # nested pack: every SKILL.md under root, filtered by include/exclude path prefixes
        root = SRC / spec["root"]
        under = lambda rel, prefixes: any(rel == p or rel.startswith(p + "/") for p in prefixes)
        for f in sorted(root.rglob("SKILL.md")) if root.is_dir() else ():
            rel = f.parent.relative_to(root).as_posix()
            if f.is_file() and under(rel, spec.get("include", [rel])) and not under(rel, exclude):
                yield pack, spec, f.parent


def is_skill_tree(p):
    """a directory holding other skills (nested packs): never linked into a rendered skill"""
    return p.is_dir() and not p.is_symlink() and next(p.rglob("SKILL.md"), None) is not None


def platform_note(spec, text):
    """Note for skills that call tools of the platform they were written for (None if none)."""
    tools = PLATFORM_TOOLS.get(spec.get("platform_tools"), ())
    found = [t for t in tools if re.search(rf"(?<![\w.$/-]){t}\(|`{t}(\([^`\n]*\))?`", text)]
    if re.search(r"(?<![\w.$/-])bash\(\s*(command\s*=|[\"'])", text):
        found.insert(0, "bash(...)")
    if not found:
        return None
    plat = spec["platform"]
    names = ", ".join(f"`{t}`" for t in found)
    lines = [f"> **Outside {plat}** (note added by RF Swift `llm-skills`): this skill was written for the "
             f"{plat} platform. {names} {'is a' if len(found) == 1 else 'are'} {plat} platform "
             f"tool{'' if len(found) == 1 else 's'}, not available here: do not call "
             f"{'it' if len(found) == 1 else 'them'}."]
    if any(t.startswith("bash") for t in found):
        lines.append("> - `bash(command=..., session=...)`: run the command directly in your own shell. "
                     "A `session` is a persistent shell: use tmux or a background job for long or "
                     "interactive commands.")
    graph = ("kg_", "validate_", "verify_", "create_finding", "update_finding", "cvss_")
    if any(t.startswith(graph) for t in found):
        lines.append(f"> - `kg_*` ({plat}'s knowledge graph) and its finding tools: record hosts, credentials, "
                     "findings and evidence with your own notes/findings tools instead, for example the "
                     "RF Swift Workbench MCP tools `write_note`, `save_finding` and `save_secret` when that "
                     "server is connected, or Markdown notes in the working directory.")
    if "load_skill" in found:
        lines.append("> - `load_skill(\"<path>\")`: read that SKILL.md file (the paths point to the local copies).")
    if any(t.startswith(("rea_", "ghidra_")) for t in found):
        lines.append("> - `rea_*`, `ghidra_*`: use the REA MCP server's tools directly when it is registered "
                     "with you (it drives Ghidra when Ghidra is installed).")
    if any(not t.startswith(("bash", "load_skill", "rea_", "ghidra_") + graph) for t in found):
        lines.append("> - the others: do the same work with the command-line tools installed here (follow the "
                     "skill's standalone path where it has one), or skip that step.")
    return "\n".join(lines) + "\n"


def render_one(pack, spec, src_dir, out, rename=None, pathmap=None):
    if out.is_symlink() or out.is_file():
        out.unlink()
    elif out.exists():
        shutil.rmtree(out)
    out.mkdir(parents=True)
    nested = "root" in spec
    for entry in src_dir.iterdir():
        if entry.name != "SKILL.md" and not (nested and is_skill_tree(entry)):
            (out / entry.name).symlink_to(entry)
    text = (src_dir / "SKILL.md").read_text(errors="replace")
    text = text.replace("{baseDir}", str(out)).replace("${CLAUDE_SKILL_DIR}", str(out))
    up = spec.get("plugin_root_up")
    if up:
        text = text.replace("${CLAUDE_PLUGIN_ROOT}", str(src_dir.parents[up - 1]))
    if spec.get("vroot") and pathmap is not None:
        text = rewrite_vpaths(spec, text, pathmap)
    m = re.match(r"---\s*\n.*?\n---[ \t]*(\n|$)", text, re.S)
    if rename and m:
        # id prefixed after a clash: keep the frontmatter name equal to the directory name
        head = re.sub(r"(?m)^name:.*$", f"name: {rename}", m.group(0), count=1)
        text = head + text[m.end():]
        m = re.match(r"---\s*\n.*?\n---[ \t]*(\n|$)", text, re.S)
    note = platform_note(spec, text) if m else None
    if note:
        text = text[:m.end()] + ("" if m.group(1) else "\n") + "\n" + note + text[m.end():]
    (out / "SKILL.md").write_text(text)
    return text, bool(note)


def rewrite_vpaths(spec, text, pathmap):
    """/skills/<rel>/SKILL.md -> the rendered copy; any other /skills/<path> -> the checkout"""
    root = SRC / spec["root"]
    top = sorted(p.name for p in root.iterdir() if p.is_dir())
    if not top:
        return text

    def sub(m):
        rel = m.group(1)
        tail = rel[len(rel.rstrip(".")):]   # sentence punctuation after the path
        rel = rel[:len(rel) - len(tail)]
        if rel.endswith("/SKILL.md") and rel[:-9] in pathmap:
            return str(RENDERED / pathmap[rel[:-9]] / "SKILL.md") + tail
        return str(root / rel) + ("/" if rel.endswith("/") else "") + tail
    pat = re.escape(spec["vroot"]) + r"((?:" + "|".join(map(re.escape, top)) + r")(?:/[\w.-]+)*/?)"
    return re.sub(r"(?<![\w.~-])" + pat, sub, text)


def write_index(cyber):
    """One small skill that stands for the whole cybersecurity pack."""
    subs = {}
    for s in cyber:
        subs[s["subdomain"] or "other"] = subs.get(s["subdomain"] or "other", 0) + 1
    lines = "\n".join(f"- `{k}`: {v}" for k, v in sorted(subs.items(), key=lambda kv: -kv[1]))
    out = RENDERED / INDEX_ID
    if out.exists():
        shutil.rmtree(out)
    out.mkdir(parents=True)
    (out / "SKILL.md").write_text(f"""---
name: {INDEX_ID}
description: Index of {len(cyber)} cybersecurity playbooks (Anthropic-Cybersecurity-Skills, MITRE ATT&CK mapped) covering penetration testing, red teaming, web/API/cloud/AD/mobile/ICS security, DFIR, malware analysis, threat intelligence, detection engineering and compliance. Use for any security assessment, exploitation, forensics or hardening task to find and load the matching playbook.
---

# Cybersecurity skills index

The {len(cyber)} skills of the cybersecurity pack are installed but not registered one by
one: their descriptions alone would take about {sum(len(s['description']) for s in cyber) // 4000}K tokens
of context on every turn. Use this index to find the right one.

1. Search the catalog (all words must match the id, subdomain, tags or description):

   ```sh
   llm-skills search sqlmap
   llm-skills search kerberos delegation
   llm-skills search --pack cybersecurity firmware
   ```

2. Read the skill it prints, `{RENDERED}/<id>/SKILL.md`, and follow it as if it had been
   loaded. Its `references/`, `scripts/` and `assets/` sit next to it.

To register a group natively for this user (or for one project with `--project`):
`llm-skills enable cybersecurity:<keyword>` (for example `cybersecurity:web-application-security`,
`cybersecurity:forensics`), or a single skill with `llm-skills enable <id>`. Agents pick new skills
up in a new session.

## Subdomains

{lines}
""")


def write_decepticon_index(skills, rank):
    """One small skill that stands for the Decepticon pack: categories and their overview skills.
    rank: id -> 2 for a category's own index skill, 1 for one that routes to nested skills."""
    cats = {}
    for s in skills:
        c = cats.setdefault(s["category"], {"n": 0, 2: [], 1: [], 0: []})
        c["n"] += 1
        c[rank.get(s["id"], 0)].append(s["id"])

    def start(v):
        ids = v[2] or v[1] or v[0][:3]
        return ", ".join(f"`{i}`" for i in ids) + (" ..." if not (v[2] or v[1]) and len(v[0]) > 3 else "")
    rows = "\n".join(f"| `{k}` | {v['n']} | {start(v)} |"
                     for k, v in sorted(cats.items(), key=lambda kv: -kv[1]["n"]))
    out = RENDERED / DECEPTICON_INDEX_ID
    if out.exists():
        shutil.rmtree(out)
    out.mkdir(parents=True)
    plat = PACKS["decepticon"]["platform"]
    (out / "SKILL.md").write_text(f"""---
name: {DECEPTICON_INDEX_ID}
description: Index of {len(skills)} offensive-security playbooks from {plat} covering web/API exploitation, recon, Active Directory, cloud and containers, post-exploitation and C2, reverse engineering, mobile, smart contracts, phishing, ICS/OT, IoT, wireless, LLM red teaming and adversary emulation. Use during an authorized engagement to find and load the matching playbook.
---

# {plat} skills index

The {len(skills)} skills of the {plat} pack are installed but most are not registered one by one:
their descriptions alone would take about {sum(len(s['description']) for s in skills) // 4000}K tokens
of context on every turn (`llm-skills status` shows which ones are). Use this index to find the right one.

1. Search the catalog (all words must match the id, subdomain, tags, keywords or description):

   ```sh
   llm-skills search --pack decepticon sub-ghz
   llm-skills search --pack decepticon kerberoasting
   ```

2. Or start from the category's overview skill below; it routes to the category's playbooks.
3. Read the skill, `{RENDERED}/<id>/SKILL.md`, and follow it as if it had been loaded.
   Its `references/` and scripts sit next to it.

{plat} wrote these skills for its own platform. Where a skill calls one of its platform tools
(`kg_add_node`, `bash(..., session=...)`, `load_skill`, ...), a note at its top says what to do
instead: run the commands directly and keep results in your own notes and findings.

To register a group natively for this user (or for one project with `--project`):
`llm-skills enable decepticon:<keyword>` (matches id, subdomain or tags, for example
`decepticon:active-directory` or `decepticon:cloud`), or a single skill with `llm-skills enable <id>`.
Agents pick new skills up in a new session.

## Categories

| Category | Skills | Start with |
|---|---:|---|
{rows}
""")


def skill_id(spec, d, fm):
    if spec.get("id_from_name"):
        n = fm.get("name")
        if isinstance(n, str) and re.fullmatch(r"[a-z0-9][a-z0-9-]{0,63}", n):
            return n
    return d.name


def cmd_render(args):
    if not SRC.is_dir():
        die(f"{SRC} not found")
    RENDERED.mkdir(parents=True, exist_ok=True)
    # pick ids first: nested packs rewrite links between their skills to the rendered ids
    plan, seen = [], {}
    for pack, spec, d in skill_dirs():
        fm0 = frontmatter((d / "SKILL.md").read_text(errors="replace")) if spec.get("id_from_name") else {}
        sid = skill_id(spec, d, fm0)
        if (sid in seen or sid in INDEX_IDS) and spec.get("id_prefix"):
            print(f"llm-skills: {pack}/{sid} renamed {spec['id_prefix']}{sid}: id already used by "
                  f"{seen.get(sid, 'an index')}", file=sys.stderr)
            sid = spec["id_prefix"] + sid
        if sid in seen or sid in INDEX_IDS:
            print(f"llm-skills: skipping {pack}/{sid}: id already used by {seen.get(sid, 'the index')}",
                  file=sys.stderr)
            continue
        seen[sid] = pack
        rename = sid if spec.get("id_from_name") and sid != fm0.get("name") else None
        plan.append((pack, spec, d, sid, rename))
    pathmaps = {}
    for pack, spec, d, sid, _ in plan:
        if "root" in spec:
            pathmaps.setdefault(pack, {})[d.relative_to(SRC / spec["root"]).as_posix()] = sid
    catalog, noted, rank = [], {}, {}
    for pack, spec, d, sid, rename in plan:
        text, note = render_one(pack, spec, d, RENDERED / sid, rename, pathmaps.get(pack))
        fm = frontmatter(text)
        entry = {"id": sid, "pack": pack, "description": fm.get("description", ""),
                 "subdomain": fm.get("subdomain", "") if isinstance(fm.get("subdomain"), str) else "",
                 "tags": tag_list(fm.get("tags")), "path": str(RENDERED / sid / "SKILL.md")}
        if isinstance(fm.get("when_to_use"), str) and fm["when_to_use"]:
            entry["keywords"] = fm["when_to_use"]
        if "root" in spec:
            parts = d.relative_to(SRC / spec["root"]).parts
            entry["category"] = parts[1] if len(parts) > 1 else parts[0]
            rank[sid] = 2 if len(parts) <= 2 else 1 if any(is_skill_tree(c) for c in d.iterdir()) else 0
        if note:
            noted[pack] = noted.get(pack, 0) + 1
        catalog.append(entry)
    cyber = [s for s in catalog if s["pack"] == "cybersecurity"]
    if cyber:
        write_index(cyber)
        catalog.append({"id": INDEX_ID, "pack": "cybersecurity-index", "subdomain": "", "tags": [],
                        "description": f"Index of the {len(cyber)} cybersecurity skills",
                        "path": str(RENDERED / INDEX_ID / "SKILL.md")})
    dec = [s for s in catalog if s["pack"] == "decepticon"]
    if dec:
        write_decepticon_index(dec, rank)
        catalog.append({"id": DECEPTICON_INDEX_ID, "pack": "decepticon-index", "subdomain": "", "tags": [],
                        "description": f"Index of the {len(dec)} Decepticon skills",
                        "path": str(RENDERED / DECEPTICON_INDEX_ID / "SKILL.md")})
    # drop rendered skills whose source is gone
    keep = {s["id"] for s in catalog}
    for old in RENDERED.iterdir():
        if old.name not in keep:
            shutil.rmtree(old) if old.is_dir() and not old.is_symlink() else old.unlink()
    CATALOG.write_text(json.dumps(catalog, indent=1))
    counts = {}
    for s in catalog:
        counts[s["pack"]] = counts.get(s["pack"], 0) + 1
    print("rendered: " + ", ".join(f"{p} {n}" for p, n in counts.items()))
    for pack, n in noted.items():
        print(f"{pack}: platform-tools note added to {n} skill(s)")


